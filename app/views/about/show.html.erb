<% content_for :title, "À propos — Balikvision Photographie" %>
<% about_description = @about_page.biography.to_s.squish.truncate(160) %>
<% content_for :meta_description, about_description if about_description.present? %>
<% content_for :og_image, @about_page.photo.url(quality: :auto, fetch_format: :auto) if @about_page.photo.attached? %>

<article class="about-bio">  <%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>
  <%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>

  <h1>À propos</h1>

  <div class="bio-content">
    <% if @about_page.photo.attached? %>
      <%= cloudinary_image_tag @about_page.photo, alt: "Portrait du photographe", width: 400, aspect_ratio: "4:5", crop: :fill, gravity: :auto, protected: true %>
    <% end %>
    <p><%= simple_format(@about_page.biography) %></p>
  </div>
</article>

<section id="contact" class="contact-section">
  <div class="contact-form">
    <h2>Me contacter</h2>
    <p>Une question, un projet ? Écrivez-moi.</p>

    <%= form_with model: @contact, url: contact_path, data: { turbo: false } do |f| %>
      <% if @contact.errors.any? %>
        <div style="color:red">
          <ul>
            <% @contact.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="field">
        <%= f.label :name do %>Nom <span aria-hidden="true">*</span><% end %>
        <%= f.text_field :name, required: true %>
      </div>

      <div class="field">
        <%= f.label :email do %>Email <span aria-hidden="true">*</span><% end %>
        <%= f.email_field :email, required: true %>
      </div>

      <div class="field">
        <%= f.label :message %>
        <%= f.text_area :message %>
      </div>

      <%# Honeypot : positionné hors écran, jamais visible pour un humain %>
      <div style="position:absolute; left:-9999px;" aria-hidden="true">
        <%= f.label :nickname %>
        <%= f.text_field :nickname, tabindex: -1, autocomplete: "off" %>
      </div>

      <%= f.submit "Envoyer", class: "btn-submit" %>
    <% end %>
  </div>
</section>

<article>
  <%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>
  <%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>

  <h1>À propos</h1>

  <div class="row">
    <div class="col-md-6">
      <% if @about_page.photo.attached? %>
        <%= cloudinary_image_tag @about_page.photo, alt: "Portrait du photographe", width: 400, height: 400, crop: :fill %>
      <% end %>
    </div>
    <div class="col-md-6">
      <p><%= simple_format(@about_page.biography) %></p>
    </div>
  </div>
</article>

<section id="contact">
  <h2>Me contacter</h2>
  <p>Une question, un projet de séance photo ? Écrivez-moi.</p>

  <%= form_with model: @contact, url: contact_path, data: { turbo: false } do |f| %>
    <% if @contact.errors.any? %>
      <div style="color:red">
        <ul>
          <% @contact.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "Nom" %>
      <%= f.text_field :name %>
    </div>

    <div>
      <%= f.label :email %>
      <%= f.email_field :email %>
    </div>

    <div>
      <%= f.label :message %>
      <%= f.text_area :message %>
    </div>

    <%# Honeypot : positionné hors écran, jamais visible pour un humain ; un bot qui le remplit se trahit %>
    <div style="position:absolute; left:-9999px;" aria-hidden="true">
      <%= f.label :nickname %>
      <%= f.text_field :nickname, tabindex: -1, autocomplete: "off" %>
    </div>

    <%= f.submit "Envoyer", class: "btn btn-dark" %>
  <% end %>
</section>

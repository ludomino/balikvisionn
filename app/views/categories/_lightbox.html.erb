<div class="lightbox-overlay" data-lightbox-target="overlay" tabindex="-1" role="dialog" aria-modal="true"
  data-action="keydown.esc->lightbox#close keydown.left->lightbox#previous keydown.right->lightbox#next keydown.tab->lightbox#trapFocus">
  <button type="button" class="lightbox-close" aria-label="Fermer" data-action="click->lightbox#close">✕</button>
  <button type="button" class="lightbox-prev" aria-label="Photo précédente" data-action="click->lightbox#previous">‹</button>
  <div class="lightbox-photo" data-lightbox-target="photo">
    <img data-lightbox-target="image" alt="" draggable="false" oncontextmenu="return false;">
    <div class="lightbox-caption" data-lightbox-target="caption">
      <p class="lightbox-caption-title" data-lightbox-target="title"></p>
      <p class="lightbox-caption-description" data-lightbox-target="description"></p>
    </div>
  </div>
  <button type="button" class="lightbox-next" aria-label="Photo suivante" data-action="click->lightbox#next">›</button>
  <p class="lightbox-counter" data-lightbox-target="counter" aria-live="polite"></p>
</div>

<% content_for :title, "#{@category.name} — Balikvision Photographie" %>
<% content_for :meta_description, "Découvrez les séries de la catégorie « #{@category.name} » du portfolio photographique de Balikvision." %>
<% first_cover = @subcategories.find { |s| s.cover.attached? }&.cover %>
<% content_for :og_image, first_cover.url(quality: :auto, fetch_format: :auto) if first_cover %>

<%= link_to root_path, class: "page-back-link" do %>
  <i class="fa-solid fa-arrow-left"></i> Retour à l'accueil
<% end %>

<h1 class="category-title"><%= @category.name %></h1>

<section class="subcategories-grid">
  <% @subcategories.each do |subcategory| %>
    <div class="card-category">
      <%= link_to category_subcategory_path(@category, subcategory) do %>
        <div class="card-image">
          <% if subcategory.cover.attached? %>
            <%= cloudinary_image_tag subcategory.cover, alt: subcategory.name, width: 400, aspect_ratio: "4:5", crop: :fill, gravity: :auto, protected: true %>
          <% else %>
            <div>No Cover Image</div>
          <% end %>
        </div>
        <div class="card-category-text"><%= subcategory.name %></div>
      <% end %>
    </div>
  <% end %>
</section>

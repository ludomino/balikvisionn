<nav class="sidebar" data-sidebar-target="nav" aria-label="Navigation principale"
     tabindex="-1"
     data-action="keydown.esc->sidebar#close keydown.tab->sidebar#trapFocus">
  <button type="button" class="sidebar-close" aria-label="Fermer le menu" data-action="click->sidebar#close">
    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
  </button>

  <div class="sidebar-nav">
    <%= link_to "Toutes les catégories", categories_path,
          class: class_names("sidebar-secondary-link", "is-current": current_page?(categories_path)),
          aria: { current: (current_page?(categories_path) ? "page" : nil) } %>

    <% sidebar_categories.each do |category| %>
      <% published_subcategories = category.subcategories.select(&:published?) %>
      <div class="sidebar-category">
        <h2 class="sidebar-category-title">
          <%= link_to category.name, category_path(category) %>
        </h2>
        <% if published_subcategories.any? %>
          <ul class="sidebar-subcategory-list">
            <% published_subcategories.each do |subcategory| %>
              <% current = @subcategory == subcategory %>
              <li>
                <%= link_to subcategory.name, category_subcategory_path(category, subcategory),
                      class: class_names("sidebar-subcategory-link", "is-current": current),
                      aria: { current: (current ? "page" : nil) } %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="sidebar-footer">
    <%= link_to "À propos", about_path,
          class: class_names("sidebar-secondary-link", "is-current": current_page?(about_path)),
          aria: { current: (current_page?(about_path) ? "page" : nil) } %>
    <div class="sidebar-socials">
      <%= render "shared/social_links" %>
    </div>
  </div>
</nav>

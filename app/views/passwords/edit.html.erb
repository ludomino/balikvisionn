<%= render layout: "shared/auth_card" do %>
  <h1>Nouveau mot de passe</h1>

  <%= tag.div(flash[:alert], style: "color:#ff8080") if flash[:alert] %>

  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <%= form.label :password, "Nouveau mot de passe" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Nouveau mot de passe", maxlength: 72 %>

    <%= form.label :password_confirmation, "Confirmer le mot de passe" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Répétez le mot de passe", maxlength: 72 %>

    <%= form.submit "Enregistrer" %>
  <% end %>
<% end %>

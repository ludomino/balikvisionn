<%= render layout: "shared/auth_card" do %>
  <%= tag.div(flash[:alert], style: "color:#ff8080") if flash[:alert] %>
  <%= tag.div(flash[:notice], style: "color:#8faf8a") if flash[:notice] %>

  <%= form_with url: session_path do |form| %>
    <%= form.label :email_address, "Adresse email" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "Votre adresse email", value: params[:email_address] %>

    <%= form.label :password, "Mot de passe" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Votre mot de passe", maxlength: 72 %>

    <%= form.submit "Se connecter" %>
  <% end %>

  <%= link_to "Mot de passe oublié ?", new_password_path %>
<% end %>

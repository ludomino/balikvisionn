<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title><%= content_for(:title) || "Balikvision Photographie" %></title>
    <meta name="description" content="<%= content_for(:meta_description) || "Portfolio photographique de Balikvision : parcourez les catégories et découvrez les séries les plus récentes." %>">
    <link rel="canonical" href="<%= request.original_url %>">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Balikvision Photographie">
    <meta property="og:title" content="<%= content_for(:title) || "Balikvision Photographie" %>">
    <meta property="og:description" content="<%= content_for(:meta_description) || "Portfolio photographique de Balikvision : parcourez les catégories et découvrez les séries les plus récentes." %>">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="<%= content_for(:og_image) || image_url("Logo_BALIKVISION_dark.png") %>">
    <%= csp_meta_tag %>
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@300;600;800&family=DM+Sans:wght@400&display=swap" rel="stylesheet">
  </head>
  <body class="public-body" data-controller="sidebar">
    <div class="site-topbar">
      <button type="button" class="topbar-burger" aria-label="Ouvrir le menu" data-action="click->sidebar#open">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
      <%= link_to root_path, class: "topbar-logo" do %>
        <%= image_tag("Logo_BALIKVISION_dark.png", alt: "Logo Balikvision") %>
      <% end %>
    </div>

    <div class="sidebar-backdrop" data-sidebar-target="backdrop" data-action="click->sidebar#close"></div>

    <div class="layout-shell">
      <%= render "shared/sidebar" %>

      <main>
        <%= yield %>
      </main>
    </div>
  </body>
</html>

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>Balikvision Photographie</title>
    <%= csp_meta_tag %>
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,700;0,900;1,700&display=swap" rel="stylesheet">
  </head>
  <body>
    <header>
      <nav>
        <div class="nav-left"></div>
        <%= link_to root_path, class: "lien-icone nav-logo" do %>
          <%= image_tag("00Logo_BALIKVISION_.png", alt: "Logo Balikvision") %>
        <% end %>
        <div class="nav-right">
          <%= link_to "À propos", about_path %>
        </div>
      </nav>
    </header>
  <main>
    <%= yield %>
  </main>

  <footer>
    <div class="icone-contact">
      <%= link_to "mailto:balik.vision.contact@gmail.com", class: "lien-icone" do %>
        <i class="fa-regular fa-user fa-lg" style="color: #ffffff;"></i>
      <% end %>
      <%= link_to "https://twitter.com/balik_vision/media", target: "_blank", class: "lien-icone" do %>
        <i class="fa-brands fa-twitter fa-lg" style="color: #ffffff;"></i>
      <% end %>
      <%= link_to "https://www.instagram.com/balik_vision", target: "_blank", class: "lien-icone" do %>
        <i class="fa-brands fa-instagram fa-lg" style="color: #ffffff;"></i>
      <% end %>
      <%= link_to "mailto:balik.vision.contact@gmail.com", target: "_blank", class: "lien-icone" do %>
        <i class="fa-solid fa-envelope fa-lg" style="color: #ffffff;"></i>
      <% end %>
    </div>
  </footer>
  </body>
</html>

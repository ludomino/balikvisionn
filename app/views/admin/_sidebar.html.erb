<nav class="admin-sidebar" data-sidebar-target="nav" aria-label="Navigation admin"
     tabindex="-1"
     data-action="keydown.esc->sidebar#close keydown.tab->sidebar#trapFocus">
  <button type="button" class="admin-sidebar-close" aria-label="Fermer le menu" data-action="click->sidebar#close">
    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
  </button>

  <div class="admin-sidebar-nav">
    <%= link_to admin_home_features_path,
          class: class_names("admin-sidebar-link", "is-current": current_page?(admin_home_features_path)),
          aria: { current: (current_page?(admin_home_features_path) ? "page" : nil) } do %>
      <i class="fa-solid fa-star" aria-hidden="true"></i> Favoris de la home
    <% end %>

    <%= link_to admin_categories_path,
          class: class_names("admin-sidebar-link", "is-current": current_page?(admin_categories_path)),
          aria: { current: (current_page?(admin_categories_path) ? "page" : nil) } do %>
      <i class="fa-solid fa-layer-group" aria-hidden="true"></i> Toutes les catégories
    <% end %>

    <%= link_to "#{admin_root_path}#admin-drafts-section", class: "admin-sidebar-link" do %>
      <i class="fa-solid fa-pen" aria-hidden="true"></i> Brouillons en cours
    <% end %>

    <%= link_to edit_admin_about_page_path,
          class: class_names("admin-sidebar-link", "is-current": current_page?(edit_admin_about_page_path)),
          aria: { current: (current_page?(edit_admin_about_page_path) ? "page" : nil) } do %>
      <i class="fa-solid fa-circle-info" aria-hidden="true"></i> À propos
    <% end %>
  </div>
</nav>

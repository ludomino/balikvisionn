<section class="subcategories-header">
  <div class="subhead">
    <div class="left-content">
      <%= link_to raw('<i class="fa-solid fa-arrow-left"></i>'), admin_categories_path, class: "btn" %>
    </div>
    <div class="center-content">
      <h1><%= @category.name %></h1>
    </div>
  </div>
    <div class="right-content">
      <%= link_to "Créer une sous-catégorie", new_admin_category_subcategory_path(@category), class: "btn btn-dark" %>
    </div>
</section>

<section class="subcategories-photos">
  <% @subcategories.each do |subcategory| %>
    <div class="subcategory">
      <div class="subinfos">
        <h2><%= subcategory.name %></h2>
        <h3><%= subcategory.description %></h3>
      </div>
      <div class="subparams">
        <%= link_to raw('<i class="fa-regular fa-pen-to-square"></i>'), edit_admin_category_subcategory_path(@category, subcategory), class: 'btn btn-icon' %>
        <%= link_to raw('<i class="fa-solid fa-trash"></i>'), admin_category_subcategory_path(@category, subcategory), data: { turbo_method: :delete, turbo_confirm: 'Confirmer la suppression ?' }, class: 'btn btn-icon' %>
      </div>
     </div>
     <div class="subphotosgrid">
       <div class="row">
         <% subcategory.photos.each do |photo| %>
           <div class="col-lg-4 col-md-6 col-sm-12">
             <%= cloudinary_image_tag photo.image, alt: photo.alt_text.presence || subcategory.name, height: 400, width: 300, crop: :fill %>
           </div>
         <% end %>
       </div>
     </div>
    </div>
  <% end %>
</section>

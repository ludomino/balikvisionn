<div class="admin-breadcrumb">
  <%= link_to admin_root_path, class: "admin-breadcrumb-link" do %>
    <i class="fa-solid fa-arrow-left"></i> Toutes les catégories
  <% end %>
</div>

<div class="admin-category-head">
  <div class="admin-category-head-top">
    <div class="admin-category-head-title">
      <h1><%= @category.name %></h1>
      <% if @category.missing_cover? %>
        <span class="admin-badge admin-badge-warning">Sans couverture</span>
      <% end %>
    </div>
    <div class="admin-category-head-actions">
      <%= link_to "Modifier la catégorie", edit_admin_category_path(@category), class: "btn-admin-outline" %>
      <%= link_to "Supprimer", admin_category_path(@category), data: { turbo_method: :delete, turbo_confirm: "Confirmer la suppression ?" }, class: "btn-admin-danger" %>
    </div>
  </div>

  <p class="admin-category-head-meta">
    <%= pluralize(@subcategories.size, "sous-catégorie") %> · <%= pluralize(@photo_count, "photo publiée", plural: "photos publiées") %>
  </p>

  <%= link_to "+ Nouvelle sous-catégorie", new_admin_category_subcategory_path(@category), class: "btn-admin-accent" %>
</div>

<div class="admin-subcategory-grid">
  <% @subcategories.each do |subcategory| %>
    <div class="admin-subcategory-card">
      <div class="admin-subcategory-card-cover">
        <% if subcategory.cover.attached? %>
          <%= cloudinary_image_tag subcategory.cover, alt: "", width: 400, height: 500, crop: :fill, gravity: :auto %>
        <% else %>
          <span class="admin-subcategory-card-cover-empty">Aucune photo</span>
        <% end %>
        <div class="admin-subcategory-card-badges">
          <% if subcategory.missing_cover? %>
            <span class="admin-badge admin-badge-warning">Sans couverture</span>
          <% end %>
          <% if subcategory.draft? %>
            <span class="admin-badge admin-badge-warning"><span class="visually-hidden">Statut : </span>Brouillon</span>
          <% end %>
        </div>
        <div class="admin-subcategory-card-icons">
          <% if subcategory.home_feature.present? %>
            <%= link_to raw('<i class="fa-solid fa-star"></i>'), admin_category_subcategory_home_feature_path(@category, subcategory), data: { turbo_method: :delete }, class: "admin-icon-btn", title: "Retirer des favoris à la une" %>
          <% else %>
            <%= link_to raw('<i class="fa-regular fa-star"></i>'), admin_category_subcategory_home_feature_path(@category, subcategory), data: { turbo_method: :post }, class: "admin-icon-btn", title: "Ajouter aux favoris à la une" %>
          <% end %>
          <%= link_to raw('<i class="fa-regular fa-pen-to-square"></i>'), edit_admin_category_subcategory_path(@category, subcategory), class: "admin-icon-btn", title: "Modifier" %>
          <%= link_to raw('<i class="fa-solid fa-trash"></i>'), admin_category_subcategory_path(@category, subcategory), data: { turbo_method: :delete, turbo_confirm: "Confirmer la suppression ?" }, class: "admin-icon-btn", title: "Supprimer" %>
        </div>
      </div>
      <%= link_to edit_admin_category_subcategory_path(@category, subcategory), class: "admin-subcategory-card-body" do %>
        <div class="admin-subcategory-card-name"><%= subcategory.name %></div>
        <div class="admin-subcategory-card-count"><%= pluralize(subcategory.photos.size, "photo") %></div>
      <% end %>
    </div>
  <% end %>
</div>

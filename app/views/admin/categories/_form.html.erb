<div class="admin-form-page">
  <div class="admin-breadcrumb">
    <% if @category.persisted? %>
      <%= link_to admin_category_path(@category), class: "admin-breadcrumb-link" do %>
        <i class="fa-solid fa-arrow-left"></i> Retour à la catégorie
      <% end %>
    <% else %>
      <%= link_to admin_root_path, class: "admin-breadcrumb-link" do %>
        <i class="fa-solid fa-arrow-left"></i> Retour au tableau de bord
      <% end %>
    <% end %>
  </div>

  <h1 class="admin-form-title">
    <%= @category.persisted? ? "Modifier la catégorie" : "Nouvelle catégorie" %>
  </h1>

  <div class="admin-form-card">
    <%= simple_form_for [:admin, @category], html: { multipart: true, class: "admin-form" } do |f| %>
      <% if @category.cover.attached? %>
        <div class="admin-form-field">
          <span class="admin-form-label">Couverture actuelle</span>
          <%= cloudinary_image_tag @category.cover, alt: "", width: 200, height: 120, crop: :fill, class: "admin-form-cover-preview" %>
        </div>
      <% end %>

      <%= f.input :name, label: "Nom de la catégorie", placeholder: "Ex. Concerts",
            input_html: { class: "field-input" }, wrapper_html: { class: "admin-form-field" }, label_html: { class: "admin-form-label" } %>

      <%= f.input :cover, as: :file, label: @category.cover.attached? ? "Remplacer la couverture" : "Photo de couverture",
            wrapper_html: { class: "admin-form-field" }, label_html: { class: "admin-form-label" } %>

      <div class="admin-form-actions">
        <%= f.submit(@category.persisted? ? "Enregistrer" : "Créer la catégorie", class: "btn-admin-accent") %>
        <%= link_to "Annuler", @category.persisted? ? admin_category_path(@category) : admin_root_path, class: "btn-admin-outline" %>
      </div>
    <% end %>
  </div>
</div>

  <div class="admin-breadcrumb">
    <%= link_to admin_root_path, class: "admin-breadcrumb-link" do %>
      <i class="fa-solid fa-arrow-left"></i> Retour au tableau de bord
    <% end %>
  </div>

  <h1 class="admin-form-title">Favoris à la une</h1>
  <p class="admin-category-head-meta">
    <%= pluralize(@home_features.size, "photo mise à la une", plural: "photos mises à la une") %>
  </p>

<div class="admin-home-features-page">
  <% if @home_features.any? %>
  <div class="admin-mosaic-grid" data-controller="sortable"
      data-sortable-url-value="<%= reorder_admin_home_features_path %>"
      data-sortable-ids-param-value="home_feature_ids"
      data-sortable-handle-value=".admin-mosaic-handle">
    <% @home_features.each do |home_feature| %>
      <% featurable = home_feature.featurable %>
      <% attachment = home_feature.featurable_type == "Photo" ? featurable.image : featurable.cover %>
      <div class="admin-mosaic-card admin-mosaic-card--span-<%= home_feature.colspan %><%= ' admin-mosaic-card--landscape' if home_feature.colspan > 1 && featurable.landscape? %>" data-id="<%= home_feature.id %>">
        <% if attachment.attached? %>
          <%= cloudinary_image_tag attachment, alt: "", width: 600, aspect_ratio: featurable.mosaic_crop_ratio(home_feature.colspan), crop: :fill, gravity: :auto, class: "admin-mosaic-photo" %>
        <% end %>

        <div class="admin-mosaic-overlay-top-left">
          <button type="button" class="admin-mosaic-handle" title="Glisser pour réordonner, ou flèches haut/bas" aria-label="Réordonner <%= home_feature.label %> — flèches haut/bas pour déplacer"><i class="fa-solid fa-grip-vertical" aria-hidden="true"></i></button>
          <div class="admin-mosaic-sizes">
            <% [1, 2, 3].each do |size| %>
              <%= link_to size, colspan_admin_home_feature_path(home_feature, colspan: size),
                    data: { turbo_method: :patch },
                    class: "admin-mosaic-size-btn#{' is-active' if home_feature.colspan == size}" %>
            <% end %>
          </div>
        </div>

        <div class="admin-mosaic-overlay-top-right">
          <%= link_to raw('<i class="fa-solid fa-trash"></i>'), admin_home_feature_path(home_feature), data: { turbo_method: :delete, turbo_confirm: "Retirer ce favori ?" }, class: "admin-mosaic-icon-btn admin-mosaic-delete-btn", title: "Retirer" %>
        </div>

        <div class="admin-mosaic-overlay-bottom">
          <div class="admin-home-feature-caption">
            <span class="admin-badge admin-badge-type"><%= home_feature.type_label %></span>
            <span class="admin-mosaic-caption"><%= home_feature.label %></span>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <% else %>
    <div class="admin-form-hint-box">
      <i class="fa-solid fa-circle-info"></i>
      <span>Aucun favori pour l'instant. Utilise le ★ sur une catégorie, une sous-catégorie ou une photo pour l'ajouter ici.</span>
    </div>
    <% end %>
</div>

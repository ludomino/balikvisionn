<div class="admin-form-page">
  <div class="admin-breadcrumb">
    <%= link_to admin_category_path(@category), class: "admin-breadcrumb-link" do %>
      <i class="fa-solid fa-arrow-left"></i> Retour à la catégorie
    <% end %>
  </div>

  <h1 class="admin-form-title">
    <%= @subcategory.persisted? ? "Modifier la sous-catégorie" : "Nouvelle sous-catégorie" %>
  </h1>

  <div class="admin-form-card">
    <%= simple_form_for [:admin, @category, @subcategory], html: { multipart: true, class: "admin-form" } do |f| %>
      <div class="admin-form-field">
        <span class="admin-form-label">Catégorie parente</span>
        <div class="admin-form-static"><%= @category.name %></div>
      </div>

      <%= f.input :name, label: "Nom de la sous-catégorie", placeholder: "Ex. Boiler Room",
            input_html: { class: "field-input" }, wrapper_html: { class: "admin-form-field" }, label_html: { class: "admin-form-label" } %>

      <%= f.input :description, label: "Description", as: :text,
            input_html: { class: "field-input", rows: 4 }, wrapper_html: { class: "admin-form-field" }, label_html: { class: "admin-form-label" } %>

      <%= f.input :photos, as: :file, label: "Ajouter des photos", input_html: { multiple: true, class: "field-input" },
            wrapper_html: { class: "admin-form-field" }, label_html: { class: "admin-form-label" } %>

      <% if @subcategory.persisted? && @subcategory.photos.any? %>
        <div class="admin-form-existing-photos">
          <p class="admin-form-hint">Photos existantes (glisser-déposer pour réordonner)</p>
          <div data-controller="sortable" data-sortable-url-value="<%= reorder_admin_category_subcategory_photos_path(@category, @subcategory) %>">
            <%= f.simple_fields_for :photos, @subcategory.photos do |photo_f| %>
              <div class="admin-form-photo-row" data-id="<%= photo_f.object.id %>">
                <%= cloudinary_image_tag photo_f.object.image, alt: photo_f.object.alt_text.presence || @subcategory.name, width: 70, height: 52, crop: :fill %>
                <%= photo_f.input :alt_text, label: false, placeholder: "Texte alternatif…", input_html: { class: "field-input" }, wrapper_html: { class: "admin-form-photo-alt" } %>
                <%= photo_f.input :colspan, label: false, collection: [1, 2, 3], include_blank: false, input_html: { class: "field-input" }, wrapper_html: { class: "admin-form-photo-colspan" } %>
                <%= link_to raw('<i class="fa-solid fa-arrow-up"></i>'), move_higher_admin_category_subcategory_photo_path(@category, @subcategory, photo_f.object), data: { turbo_method: :patch }, class: "admin-icon-btn", title: "Monter" %>
                <%= link_to raw('<i class="fa-solid fa-arrow-down"></i>'), move_lower_admin_category_subcategory_photo_path(@category, @subcategory, photo_f.object), data: { turbo_method: :patch }, class: "admin-icon-btn", title: "Descendre" %>
                <%= link_to raw('<i class="fa-solid fa-trash"></i>'), admin_category_subcategory_photo_path(@category, @subcategory, photo_f.object), data: { turbo_method: :delete, turbo_confirm: "Supprimer cette photo ?" }, class: "admin-icon-btn", title: "Supprimer" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="admin-form-hint-box">
        <i class="fa-solid fa-circle-info"></i>
        <span>Les photos se gèrent aussi depuis l'éditeur mosaïque, une fois la sous-catégorie créée.</span>
      </div>

      <div class="admin-form-actions">
        <%= f.submit(@subcategory.persisted? ? "Enregistrer" : "Créer la sous-catégorie", class: "btn-admin-accent") %>
        <%= link_to "Annuler", admin_category_path(@category), class: "btn-admin-outline" %>
      </div>
    <% end %>
  </div>
</div>

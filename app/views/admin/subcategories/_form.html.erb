<div class="admin-form-page admin-form-page--split">
  <div class="admin-breadcrumb">
    <%= link_to admin_category_path(@category), class: "admin-breadcrumb-link" do %>
      <i class="fa-solid fa-arrow-left"></i> Retour à la catégorie
    <% end %>
  </div>
  <div class="admin-form-title-row">
    <h1 class="admin-form-title">
      <%= @subcategory.persisted? ? "Modifier #{@subcategory.name}" : "Nouvelle sous-catégorie" %>
    </h1>
    <% if @subcategory.persisted? && @subcategory.draft? %>
      <span class="admin-badge admin-badge-warning"><span class="visually-hidden">Statut : </span>Brouillon</span>
    <% end %>
  </div>
  <%= simple_form_for [:admin, @category, @subcategory], html: { multipart: true, class: "admin-form-split", data: { controller: "photo-preview" } } do |f| %>
    <div class="admin-form-split-left">
      <div class="admin-form-card">
        <div class="admin-form-field">
          <span class="admin-form-label">Catégorie parente</span>
          <div class="admin-form-static"><%= @category.name %></div>
        </div>

        <%= f.input :name, label: "Nom de la sous-catégorie", placeholder: "Ex. Boiler Room",
              input_html: { class: "field-input" }, wrapper_html: { class: "admin-form-field" }, label_html: { class: "admin-form-label" } %>

        <%= f.input :description, label: "Description", as: :text,
              input_html: { class: "field-input", rows: 4 }, wrapper_html: { class: "admin-form-field" }, label_html: { class: "admin-form-label" } %>


        <div class="admin-form-field" data-controller="photo-preview" data-photo-preview-thumb-class-value="admin-form-cover-thumb">
          <span class="admin-form-label">Image de couverture</span>
          <div class="admin-form-avatar-row">
            <div data-photo-preview-target="list">
              <% if @subcategory.cover.attached? %>
                <%= cloudinary_image_tag @subcategory.cover, alt: "", width: 72, height: 72, crop: :fill, class: "admin-form-cover-thumb" %>
              <% else %>
                <span class="admin-form-cover-thumb admin-form-avatar-empty"></span>
              <% end %>
            </div>

            <div class="admin-form-cover-info">
              <span class="admin-form-cover-filename" data-photo-preview-target="name">
                <%= @subcategory.cover.filename if @subcategory.cover.attached? %>
              </span>
              <label for="subcategory_cover" class="admin-form-cover-replace-link">
                <%= @subcategory.cover.attached? ? "Remplacer l'image" : "Choisir une image" %>
              </label>
            </div>
          </div>

          <%= f.input :cover, as: :file, label: false, wrapper: false,
                input_html: { id: "subcategory_cover", class: "admin-visually-hidden-input",
                              data: { photo_preview_target: "input", action: "change->photo-preview#show" } } %>
        </div>

        <%= f.input :photos, as: :file, label: false, wrapper: false,
              input_html: { multiple: true, id: "subcategory_photos", class: "admin-visually-hidden-input",
                            data: { photo_preview_target: "input", action: "change->photo-preview#show" } } %>

        <div class="admin-form-actions">
          <%= button_tag(@subcategory.persisted? ? "Enregistrer" : "Créer et publier", type: "submit", name: "subcategory[status]", value: "published", class: "btn-admin-accent") %>
          <%= button_tag "Brouillon", type: "submit", name: "subcategory[status]", value: "draft", class: "btn-admin-outline" %>
          <%= link_to "Annuler", admin_category_path(@category), class: "btn-admin-outline" %>
        </div>
      </div>
    </div>

    <div class="admin-form-split-right">
      <div class="admin-mosaic-header">
        <div>
          <h2 class="admin-mosaic-heading">
            <%= @subcategory.persisted? ? @subcategory.name : "Photos" %>
          </h2>
          <% if @subcategory.persisted? && @subcategory.photos.any? %>
            <p class="admin-form-hint">
              <%= pluralize(@subcategory.photos.count, "photo", plural: "photos") %> · glisser pour réordonner, choisir 1 / 2 / 3 pour la largeur
            </p>
          <% end %>
        </div>
        <label for="subcategory_photos" class="btn-admin-accent">+ Ajouter des photos</label>
      </div>

      <div class="admin-form-photo-preview" data-photo-preview-target="list"></div>

      <% if @subcategory.persisted? && @subcategory.photos.any? %>
        <div class="admin-mosaic-grid" data-controller="sortable"
            data-sortable-url-value="<%= reorder_admin_category_subcategory_photos_path(@category, @subcategory) %>"
            data-sortable-handle-value=".admin-mosaic-handle">
          <%= f.simple_fields_for :photos, @subcategory.photos do |photo_f| %>
            <% photo = photo_f.object %>
            <div class="admin-mosaic-card admin-mosaic-card--span-<%= photo.colspan %><%= ' admin-mosaic-card--landscape' if photo.colspan > 1 && photo.landscape? %>" data-id="<%= photo.id %>" data-controller="mosaic-card">
            <%= cloudinary_image_tag photo.image, alt: photo.alt_text.presence || @subcategory.name, width: 600, aspect_ratio: photo.mosaic_crop_ratio(photo.colspan), crop: :fill, gravity: :auto, class: "admin-mosaic-photo" %>
              <div class="admin-mosaic-overlay-top-left">
                <span class="admin-mosaic-handle" title="Glisser pour réordonner"><i class="fa-solid fa-grip-vertical"></i></span>
                <div class="admin-mosaic-sizes">
                  <% [1, 2, 3].each do |size| %>
                    <%= link_to size, colspan_admin_category_subcategory_photo_path(@category, @subcategory, photo, colspan: size),
                          data: { turbo_method: :patch },
                          class: "admin-mosaic-size-btn#{' is-active' if photo.colspan == size}" %>
                  <% end %>
                </div>
              </div>
              <div class="admin-mosaic-overlay-top-right">
                <% if photo.home_feature.present? %>
                  <%= link_to raw('<i class="fa-solid fa-star"></i>'), admin_category_subcategory_photo_home_feature_path(@category, @subcategory, photo), data: { turbo_method: :delete }, class: "admin-mosaic-icon-btn", title: "Retirer des favoris à la une" %>
                <% else %>
                  <%= link_to raw('<i class="fa-regular fa-star"></i>'), admin_category_subcategory_photo_home_feature_path(@category, @subcategory, photo), data: { turbo_method: :post }, class: "admin-mosaic-icon-btn", title: "Ajouter aux favoris à la une" %>
                <% end %>
              </div>
              <div class="admin-mosaic-overlay-bottom-right">
                <%= button_tag type: "button", class: "admin-mosaic-icon-btn", title: "Titre, description & texte alternatif", data: { action: "mosaic-card#toggleAlt" } do %>
                  <i class="fa-solid fa-pen"></i>
                <% end %>
                <%= link_to raw('<i class="fa-solid fa-trash"></i>'), admin_category_subcategory_photo_path(@category, @subcategory, photo), data: { turbo_method: :delete, turbo_confirm: "Supprimer cette photo ?" }, class: "admin-mosaic-icon-btn admin-mosaic-delete-btn", title: "Supprimer" %>
              </div>
              <div class="admin-mosaic-overlay-bottom" data-mosaic-card-target="altPanel" hidden>
                <%= photo_f.input :title, label: false, placeholder: "Titre…", input_html: { class: "field-input" }, wrapper_html: { class: "admin-mosaic-alt-field" } %>
                <%= photo_f.input :description, label: false, as: :text, placeholder: "Description…", input_html: { class: "field-input", rows: 2 }, wrapper_html: { class: "admin-mosaic-alt-field" } %>
                <%= photo_f.input :alt_text, label: false, placeholder: "Texte alternatif…", input_html: { class: "field-input" }, wrapper_html: { class: "admin-mosaic-alt-field" } %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="admin-form-hint-box">
          <i class="fa-solid fa-circle-info"></i>
          <span>Les photos se gèrent aussi depuis l'éditeur mosaïque, une fois la sous-catégorie créée.</span>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

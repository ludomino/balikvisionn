<div class="admin-form-page">
  <div class="admin-breadcrumb">
    <%= link_to admin_root_path, class: "admin-breadcrumb-link" do %>
      <i class="fa-solid fa-arrow-left"></i> Retour au tableau de bord
    <% end %>
  </div>

  <h1 class="admin-form-title">Modifier la page À propos</h1>

  <div class="admin-form-card">
    <%= simple_form_for @about_page, url: admin_about_page_path, html: { multipart: true, class: "admin-form" } do |f| %>
    <div class="admin-form-field" data-controller="photo-preview" data-photo-preview-thumb-class-value="admin-form-avatar">
      <span class="admin-form-label">Photo de profil</span>
      <div class="admin-form-avatar-row">
        <div data-photo-preview-target="list">
          <% if @about_page.photo.attached? %>
            <%= cloudinary_image_tag @about_page.photo, alt: "", width: 78, height: 78, crop: :fill, class: "admin-form-avatar" %>
          <% else %>
            <span class="admin-form-avatar admin-form-avatar-empty"></span>
          <% end %>
        </div>

        <div class="admin-form-cover-info">
          <span class="admin-form-cover-filename" data-photo-preview-target="name">
            <%= @about_page.photo.filename if @about_page.photo.attached? %>
          </span>
          <label for="about_page_photo" class="admin-form-cover-replace-link">
            <%= @about_page.photo.attached? ? "Remplacer la photo" : "Choisir une photo" %>
          </label>
        </div>
      </div>

      <%= f.input :photo, as: :file, label: false, wrapper: false,
            input_html: { id: "about_page_photo", class: "admin-visually-hidden-input", "aria-label": "Photo de profil",
                          data: { photo_preview_target: "input", action: "change->photo-preview#show" } } %>
    </div>

      <%= f.input :biography, label: "Texte de présentation", as: :text,
            input_html: { class: "field-input", rows: 7 }, wrapper_html: { class: "admin-form-field" }, label_html: { class: "admin-form-label" } %>

      <div class="admin-form-hint-box">
        <i class="fa-solid fa-circle-info"></i>
        <span>Le formulaire de contact du site envoie vers balik.vision.contact@gmail.com — non modifiable ici.</span>
      </div>

      <div class="admin-form-actions">
        <%= f.submit "Enregistrer", class: "btn-admin-accent" %>
        <%= link_to "Annuler", admin_root_path, class: "btn-admin-outline" %>
      </div>
    <% end %>
  </div>
</div>
